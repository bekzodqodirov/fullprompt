DATABASE_URL=postgres://postgres:password@localhost:5432/gsr
# Must be public HTTPS: it is where the client's Telegram Mini App is served
# from, and Telegram refuses to open one on plain http. Anything else and the
# cabinet button is simply not offered (#275).
APP_URL=https://your-domain.example
SESSION_SECRET=generate-a-long-random-string
TELEGRAM_BOT_TOKEN=
# my.telegram.org → API development tools. Needed ONLY by `pnpm tg-import`,
# which reads a manager's existing client conversations into the CRM
# (docs/TELEGRAM-CRM.md). One pair for the whole company.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Encrypts the stored Telegram session behind LIVE receiving (`pnpm tg-login`,
# `pnpm tg-listen`). Not needed for the history import, which keeps no session.
# It protects a manager's PERSONAL account, so it is its own key and not
# derived from SESSION_SECRET — rotating one must not break the other. Losing
# it means every manager logs in again; leaking it means somebody with the
# database can read their Telegram. Generate with:  openssl rand -base64 32
TG_SESSION_KEY=
# Which Telegram account the `tg-listen` service connects as. One account per
# container: a second manager is a second service block with their own number.
#   docker compose --profile telegram up -d
TG_LISTEN_PHONE=
TRANSLATE_PROVIDER=libretranslate
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=gsr-files
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=.data/files
SENTRY_DSN=
TELEGRAM_POLLING=1
BACKUP_DIR=.data/backups
BACKUP_RETENTION_DAYS=30
ANTHROPIC_API_KEY=

# --- Off-site backup: the owner's Google Drive (docs/BACKUP.md) ---
# Optional. Without these the nightly dump stays on this machine only, which
# means losing the VPS loses the database AND every copy of it.
# The app must be PUBLISHED before the refresh token is minted, or the token
# dies after 7 days. Get them with:  pnpm gdrive-auth
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# How many dumps to keep in Drive (default: BACKUP_RETENTION_DAYS, else 30).
GDRIVE_RETENTION=30
