{
  "name": "gsr-erp",
  "version": "0.1.0",
  "private": true,
  "description": "GSR LOGISTICS ERP — Phase 1: WMS",
  "scripts": {
    "dev": "node scripts/heal-storage.mjs && next dev",
    "build": "node scripts/heal-storage.mjs && next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/modules/platform/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:files": "node scripts/check-storage.mjs",
    "backup": "tsx scripts/backup.ts",
    "restore-test": "tsx scripts/restore-test.ts",
    "refresh": "pnpm install && pnpm db:migrate && pnpm build",
    "start:https": "node scripts/start-https.mjs",
    "dev:https": "node scripts/heal-storage.mjs && next dev --experimental-https",
    "demo-users": "tsx scripts/demo-users.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@node-rs/argon2": "^2.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@serwist/next": "^9.0.11",
    "@zxing/browser": "^0.2.1",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "grammy": "^1.45.1",
    "leaflet": "^1.9.4",
    "next": "^15.1.6",
    "next-intl": "^3.26.3",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "pmtiles": "^4.4.1",
    "postgres": "^3.4.5",
    "protomaps-leaflet": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.33.5",
    "subset-font": "^2.5.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.49.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "serwist": "^9.0.11",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0"
}
